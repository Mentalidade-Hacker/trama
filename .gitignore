# Personal graphs, SQLite sidecars, attachments and backups are not source code.
*.db
*.sqlite
*.sqlite3
*-wal
*-shm
*-journal
/data/
/userdata/
/attachments/
/backups/
/sync/
/vault/

# The generated dictionary is shipped as a release asset, not committed.
/resources/dictionary.sqlite

