* text=auto

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve third-party package bytes, including legacy dictionary encodings
# and upstream license/source files; do not normalize their line endings.
web/vendor/** -text
*.aff -text
*.dic -text
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.db binary
